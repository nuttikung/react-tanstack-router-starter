    "lint": "eslint .",
    "lint-staged": "lint-staged --config lint-staged.config.js",
    "prepare": "husky",
    "preview": "vite preview",
    "type-check": "tsc --project ./tsconfig.app.json --noEmit"
  },
  "dependencies": {
