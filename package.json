{
  "name": "react-tanstack-router-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Fast starter project with React, Shadcn, Tanstack Router and Vite",
  "homepage": "https://nuttikung.github.io/react-tanstack-router-starter/",
  "license": "MIT",
  "author": "Phudit Chuengjaroen",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "predeploy": "pnpm run build",
